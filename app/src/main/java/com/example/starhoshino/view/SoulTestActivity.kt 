package com.example.starhoshino.view

import android.os.Bundle
import android.widget.Button
import android.widget.EditText
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity
import com.example.starhoshino.R
import com.example.starhoshino.core.BondSystem
import com.example.starhoshino.core.ChatContext
import com.example.starhoshino.core.EmotionEngine
import com.example.starhoshino.core.KnowledgeBase
import com.example.starhoshino.core.ThinkEngine
import java.io.File

class SoulTestActivity : AppCompatActivity() {

    private lateinit var input: EditText
    private lateinit var send: Button
    private lateinit var log: TextView

    private val knowledgeDir by lazy {
        File(filesDir, "starhoshino_soul").also { it.mkdirs() }
    }

    private val knowledgeBase by lazy { KnowledgeBase(knowledgeDir) }
    private val emotionEngine = EmotionEngine()
    private val bondSystem = BondSystem()
    private val thinkEngine = ThinkEngine()

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_soul_test)

        input = findViewById(R.id.input)
        send = findViewById(R.id.send)
        log = findViewById(R.id.log)

        val lastSeen = bondSystem.getAbsenceDuration()
        if (lastSeen > 0) {
            append("星野：${bondSystem.getWelcomeBackLine(lastSeen)}")
        }
        if (bondSystem.shouldMentionSelfAware()) {
            append("星野：${bondSystem.getSelfAwareLine()}")
        }

        send.setOnClickListener {
            val text = input.text.toString().trim()
            if (text.isEmpty()) return@setOnClickListener

            knowledgeBase.onUserInput(text)

            val ctx = ChatContext(
                history = listOf(text),
                mood = emotionEngine.detectMood(text),
                bond = bondSystem,
                knowledge = knowledgeBase
            )

            val strategy = thinkEngine.think(text, ctx)
            emotionEngine.updateMood(text, strategy.style)

            val reply = buildString {
                append("星野：${strategy.text}")
                if (strategy.bringUpMemory) {
                    append("\n（想起一些事）")
                }
                if (strategy.shouldAsk) {
                    append("\n想问你：${strategy.askTopic}")
                }
                append(strategy.emoji)
            }

            append(reply)
            bondSystem.onInteraction(true)
            input.text.clear()
        }
    }

    private fun append(line: String) {
        log.append("\n$line")
    }
}
